        <div id="instagram" class="content">Welcome to Instagram!</div>
        <div id="twitter" class="content">Welcome to Twitter!</div>
        <div id="linkedin" class="content">Welcome to LinkedIn!</div> -->

        <!-- ======================= filter================== -->

        <div class="header">
          <div class="filters-container">
            <div class="filters">
              <div class="search">
                <label>
                  <input type="text" placeholder="Search here" />
                  <ion-icon name="search-outline"></ion-icon>
                </label>
              </div>
              <select id="dateRange">
                <option value="day">This Day</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="year">This Year</option>
              </select>
              <select id="socialMedia">
                <option value="">All Platforms</option>
                <option value="facebook">
                  <span class="iconify" data-icon="logos:facebook"></span>
                  Facebook
                </option>
                <option value="instagram">
                  <span
                    class="iconify"
                    data-icon="skill-icons:instagram"
                  ></span>
                  Instagram
                </option>
                <option value="linkedin">
                  <span class="iconify" data-icon="devicon:linkedin"></span>
                  LinkedIn
                </option>
                <option value="twitter">
                  <span class="iconify" data-icon="skill-icons:twitter"></span>
                  Twitter
                </option>
              </select>
              <select id="Type">
                <option value="day">Type</option>
                <option value="week">Photo</option>
                <option value="month">Video</option>
              </select>
            </div>
            <div class="grid-toggle">
              <span>Grid View</span>
              <label class="switch">
                <input
                  id="gridSwitch"
                  type="checkbox"
                  onchange="toggleView()"
                />
                <span class="slider round"></span>
              </label>
            </div>
          </div>
        </div>
        <!-- ======================= Cards ================== -->
        <div class="cardBox" id="cardContainer">
            @foreach(var post in Model)
            {
                @Html.Partial("~/Views/Shared/Post/_post.cshtml",post);
            }
        </div>
        <!-- Post Details (Modal) -->
        <!-- Post Details Section (NOT a modal, always in layout) -->
       <!-- Post Details (Modal) -->

      </div>
